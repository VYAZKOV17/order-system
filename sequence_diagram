@startuml
title Диаграмма последовательности Оформление заказа
actor "Клиент" as Client

participant "Frontend" as Front
participant "API Gateway" as Gate
participant "Order Service" as OrderService
participant "Inventory Service" as InventoryService
participant "Payment Service" as PaymentService
participant "Notification Service" as NotificationService

database  Database

== Создание заказа ==

Client -> Front : POST /orders
Front -> Gate : POST /orders
Gate -> OrderService : POST /orders

OrderService -> Database : INSERT order\nstatus = CREATED
Database --> OrderService : orderId

OrderService --> Gate : 201 Created\norderId
Gate --> Front : 201 Created
Front --> Client : Заказ создан

== Проверка наличия ==

OrderService -> InventoryService : GET /items/{id}/availability

InventoryService --> OrderService : available / unavailable


alt Товар недоступен

    OrderService -> Database : UPDATE order\nstatus = CANCELLED

    OrderService -> NotificationService : POST /notifications
    NotificationService --> OrderService : 202 Accepted

    OrderService --> Gate : 409 Conflict
    Gate --> Front : 409 Conflict
    Front --> Client : Товар недоступен

else Товар доступен

    == Резервирование ==

    OrderService -> InventoryService : POST /reservations
    InventoryService --> OrderService : 201 Created\nreservationId

    OrderService -> Database : UPDATE order\nstatus = PENDING_PAYMENT


    == Оплата ==

    OrderService -> PaymentService : POST /payments

    PaymentService -> Database : INSERT payment\nstatus = PENDING
    Database --> PaymentService : paymentId

    PaymentService --> OrderService : paymentId


    alt Оплата успешна

        PaymentService --> OrderService : 200 OK\npaymentStatus = SUCCESS

        OrderService -> Database : UPDATE order\nstatus = PAID

        OrderService -> NotificationService : POST /notifications\norderPaid
        NotificationService --> OrderService : 202 Accepted

        OrderService --> Gate : 200 OK\nstatus = PAID
        Gate --> Front : 200 OK
        Front --> Client : Заказ оплачен

    else Оплата неуспешна

        PaymentService --> OrderService : 402 Payment Required

        OrderService -> InventoryService : DELETE /reservations/{id}
        InventoryService --> OrderService : 204 No Content

        OrderService -> Database : UPDATE order\nstatus = PAYMENT_FAILED

        OrderService -> NotificationService : POST /notifications\npaymentFailed
        NotificationService --> OrderService : 202 Accepted

        OrderService --> Gate : 402 Payment Required
        Gate --> Front : 402 Payment Required
        Front --> Client : Ошибка оплаты

    end

end

@endum